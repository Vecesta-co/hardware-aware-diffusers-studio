# Hardware-Aware Diffusers Studio — Configuration
# Output directory for generated images
OUTPUT_DIR=outputs

# Preferred backend: 'auto' (detects hardware), 'cuda', 'cpu', 'procedural'
BACKEND_DEVICE=auto

# Web studio server port
PORT=7860
HOST=127.0.0.1

# Default resolution
DEFAULT_WIDTH=512
DEFAULT_HEIGHT=512
